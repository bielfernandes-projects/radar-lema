# ============================================================
# Radar Lema — variáveis de ambiente
# Copie este arquivo para `.env.local` e preencha com valores reais.
# Nunca commite `.env.local` (já está no .gitignore via `*.local`).
# ============================================================

# --- Frontend (Vite) ---
# URL do projeto Supabase (Settings > API > Project URL).
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave anon pública do projeto. Pode ser exposta ao cliente.
VITE_SUPABASE_ANON_KEY=sua-chave-anon

# Opcional: chave da Google Maps para renderizar o embed do mapa.
# Só usada nos eventos Presencial/Híbrido.
VITE_GOOGLE_MAPS_API_KEY=

# --- Notificações push (Web Push API) ---
# CHAVE PÚBLICA VAPID (pode ser exposta ao cliente). Gere com:
#   npx web-push generate-vapid-keys --json
# O par público vai aqui (frontend) e tb no Edge Function (VAPID_PUBLIC_KEY).
# O privado/VAPID_SUBJECT são usados SOMENTE no Edge Function (nunca no client).
VITE_VAPID_PUBLIC_KEY=

# --- CLI / scripts de administração (NUNCA expor ao frontend) ---
# Token de acesso do Supabase (Dashboard > Account > Access Tokens).
# Permite o `supabase link`, `db push`, `migration` etc.
SUPABASE_ACCESS_TOKEN=sbp_sua-chave-de-acesso

# Chave service_role do projeto (Settings > API > service_role secret).
# Usada apenas por scripts de seed/admin (ex.: seed-mock-users.mjs).
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role

# --- Hub da Lema ---
# Chave da NewsAPI (https://newsapi.org) para a Edge Function `news-ingest`.
NEWSAPI_KEY=sua-chave-newsapi

# Token de acesso da API do UNO (header `x-access-token`). Rotacionar antes
# de ir a produção — o valor atual está exposto em api_uno/api_uno.yml.
# Usado pela Edge Function `uno-proxy` (nunca no frontend).
UNO_ACCESS_TOKEN=seu-token-uno
